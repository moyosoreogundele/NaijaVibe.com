# Server-side settings. Copy this file to .env and set real values locally.
# Required to send signup verification codes and password-reset emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_NAME=NaijaVibe
# Optional: YouTube Data API key for Nigeria-wide trending videos.
# Create a key in Google Cloud Console and restrict it to YouTube Data API v3.
YOUTUBE_API_KEY=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
APP_URL=http://localhost:8000
PORT=8000
# Optional: choose a persistent database path when deploying.
# AUTH_DB_PATH=C:\data\naijavibe-auth.sqlite
