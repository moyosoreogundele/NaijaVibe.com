# Server-side settings. Copy this file to .env and set real values locally.
# Required to send signup verification codes and password-reset emails.
# Verify the sender's domain in Resend before using that address for delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_NAME=NaijaVibe
# Optional: YouTube Data API key for Nigeria-wide trending videos.
# Create a key in Google Cloud Console and restrict it to YouTube Data API v3.
YOUTUBE_API_KEY=
# Agora RTC server-side credentials for live audio/video.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Optional: set a stable VAPID key pair for web push. Otherwise keys are generated
# once and persisted in the SQLite app_settings table.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
APP_URL=http://localhost:8000
PORT=8000
# Optional: choose a persistent database path when deploying.
# AUTH_DB_PATH=C:\data\naijavibe-auth.sqlite
